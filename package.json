{
  "name": "@catalex/root",
  "description": "Open-Source AI LaTeX writing workspace",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RicercarG/Catalex"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "branding:check": "node scripts/branding.mjs",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "icons:update": "./scripts/update-icons.sh",
    "dev:desktop": "node scripts/build-desktop.mjs dev",
    "build:claude-sidecar": "pnpm --filter=@catalex/desktop-sidecar build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint": "pnpm version:sync && pnpm exec biome check",
    "lint:fix": "pnpm version:sync && pnpm exec biome check --fix",
    "release": "pnpm package:desktop",
    "prepare": "husky",
    "build:native": "node scripts/build-native.mjs",
    "package:desktop": "node scripts/build-desktop.mjs package",
    "package:mac:signed": "node scripts/build-desktop.mjs signed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "husky": "^9.1.7",
    "turbo": "^2.7.6"
  },
  "packageManager": "pnpm@10.28.2",
  "license": "AGPL-3.0-or-later"
}
