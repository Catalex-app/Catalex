    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror-lang-latex": "^0.2.0",
    "date-fns": "^4.1.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.28",
