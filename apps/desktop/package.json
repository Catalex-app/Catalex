    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
