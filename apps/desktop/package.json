{
  "name": "@catalex/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/build-document-core.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "generate-previews": "tsx scripts/generate-previews.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sidebar-harness": "playwright test -c playwright.config.ts e2e/sidebar-animation-harness.spec.ts",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:typecheck": "tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:pack": "electron-builder --dir --config electron-builder.cjs",
    "test:electron": "vitest run -c vitest.electron.config.ts",
    "test:electron-smoke": "node e2e/electron/smoke.mjs",
    "test:electron-persistence": "node e2e/electron/persistence-smoke.mjs",
    "test:electron-profile": "node e2e/electron/profile-persistence-smoke.mjs",
    "test:electron-windows": "node e2e/electron/multi-window-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
